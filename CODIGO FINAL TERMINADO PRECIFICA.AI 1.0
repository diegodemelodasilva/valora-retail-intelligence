# --- Funções Auxiliares ---
def normalizar_texto(texto):
    try:
        texto = str(texto).lower()
        texto = re.sub(r'\s+', ' ', texto)
        texto = re.sub(r'[^\w\s.\\()-/+]', '', texto)
        return texto.strip()
    except Exception:
        return ""


def extrair_preco(valor):
    try:
        # Verifica se o valor é NaN ou None primeiro
        if pd.isna(valor) or valor is None:
            return None

        texto = str(valor).strip().lower()

        # Se o texto está vazio ou é 'nan', retorna None
        if not texto or texto == 'nan':
            return None

        texto = re.sub(r'(?<=\d)\s+(?=\d)', '', texto)
        texto = re.sub(r'[r$]|\s+', '', texto)

        if ',' in texto and '.' in texto:
            if texto.rfind(',') > texto.rfind('.'):
                texto = texto.replace('.', '').replace(',', '.')
            else:
                texto = texto.replace(',', '')
        elif ',' in texto:
            texto = texto.replace(',', '.')

        preco = float(texto)
        if preco <= 0:
            return None
        return preco
    except (ValueError, TypeError):
        return None


# --- Classe do Diálogo de Login ---
class LoginDialog(QtWidgets.QDialog):
    def __init__(self, parent=None):
        super().__init__(parent)
        self.setWindowTitle("Login - Precifica.ai")
        self.setMinimumSize(600, 500)  # Janela maior
        self.setStyleSheet("background-color: #f5f5f5; font-size: 13px;")

        layout = QtWidgets.QVBoxLayout(self)
        layout.setContentsMargins(50, 50, 50, 50)
        layout.setSpacing(30)

        # === CORREÇÃO 1: ADICIONAR BRANDING ===
        # Nome da aplicação - PRECIFICA.AI
        app_name = QtWidgets.QLabel("PRECIFICA.AI")
        app_name.setStyleSheet("""
            font-size: 28px;
            font-weight: bold;
            color: #0077b6;
            text-align: center;
            margin-bottom: 10px;
        """)
        app_name.setAlignment(QtCore.Qt.AlignCenter)
        layout.addWidget(app_name)

        # Nome da empresa - VALORA RETAIL INTELLIGENCE
        company_name = QtWidgets.QLabel("VALORA RETAIL INTELLIGENCE")
        company_name.setStyleSheet("""
            font-size: 16px; 
            color: #666666;
            text-align: center;
            margin-bottom: 20px;
        """)
        company_name.setAlignment(QtCore.Qt.AlignCenter)
        layout.addWidget(company_name)

        # Campos de Login e Senha
        form_layout = QtWidgets.QFormLayout()
        form_layout.setSpacing(10)

        self.login_input = QtWidgets.QLineEdit()
        self.login_input.setPlaceholderText("Login")
        self.login_input.setFixedHeight(35)
        self.login_input.setStyleSheet(
            "border: 1px solid #cccccc; border-radius: 5px; padding: 5px; background-color: white;")
        form_layout.addRow(QtWidgets.QLabel("Login:"), self.login_input)

        self.senha_input = QtWidgets.QLineEdit()
        self.senha_input.setPlaceholderText("Senha")
        self.senha_input.setEchoMode(QtWidgets.QLineEdit.Password)
        self.senha_input.setFixedHeight(35)
        self.senha_input.setStyleSheet(
            "border: 1px solid #cccccc; border-radius: 5px; padding: 5px; background-color: white;")
        form_layout.addRow(QtWidgets.QLabel("Senha:"), self.senha_input)

        layout.addLayout(form_layout)

        # Botão de Login
        btn_login = QtWidgets.QPushButton("Entrar")
        btn_login.setFixedHeight(40)
        btn_login.setStyleSheet("""
            QPushButton {
                background-color: #0077b6;
                color: white;
                border-radius: 5px;
                padding: 10px;
                font-weight: bold;
            }
            QPushButton:hover {
                background-color: #005f8c;
            }
        """)
        btn_login.clicked.connect(self.handle_login)
        layout.addWidget(btn_login)

    def handle_login(self):
        login = self.login_input.text()
        senha = self.senha_input.text()

        if login == "adm" and senha == "adm123":
            self.accept()  # Fecha o diálogo com sucesso
        else:
            QtWidgets.QMessageBox.warning(self, "Erro de Login", "Login ou senha incorretos.")
            self.senha_input.clear()


