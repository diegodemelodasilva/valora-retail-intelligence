# --- Classe do Diálogo de Filtros Avançados ---
class FiltroAvancadoDialog(QtWidgets.QDialog):
    def __init__(self, df, parent=None):
        super().__init__(parent)
        self.df = df
        self.setWindowTitle("Filtros Avançados")
        self.setMinimumWidth(400)
        self.setStyleSheet("background-color: #FFFFFF; font-size: 13px;")

        layout = QtWidgets.QVBoxLayout(self)
        layout.setContentsMargins(15, 15, 15, 15)
        layout.setSpacing(10)

        preco_layout = QtWidgets.QHBoxLayout()
        self.preco_min = QtWidgets.QLineEdit()
        self.preco_min.setPlaceholderText("Preço Mínimo (ex: 100.00)")
        self.preco_max = QtWidgets.QLineEdit()
        self.preco_max.setPlaceholderText("Preço Máximo (ex: 1000.00)")
        for input_field in [self.preco_min, self.preco_max]:
            input_field.setFixedHeight(30)
            input_field.setStyleSheet("border: 1px solid #cccccc; border-radius: 5px; padding: 5px;")
            validator = QtGui.QDoubleValidator()
            validator.setBottom(0)
            validator.setDecimals(2)
            input_field.setValidator(validator)
        preco_layout.addWidget(QtWidgets.QLabel("Preço:"))
        preco_layout.addWidget(self.preco_min)
        preco_layout.addWidget(QtWidgets.QLabel("até"))
        preco_layout.addWidget(self.preco_max)
        layout.addLayout(preco_layout)

        self.loja_input = QtWidgets.QComboBox()
        self.loja_input.addItem("Todas as Lojas")
        # Verifica se a coluna 'loja' existe e não está vazia antes de adicionar itens
        if 'loja' in self.df.columns and not self.df['loja'].dropna().empty:
            lojas = sorted(self.df['loja'].dropna().unique())
            self.loja_input.addItems(lojas)
        self.loja_input.setStyleSheet("border: 1px solid #cccccc; border-radius: 5px; padding: 5px;")
        layout.addWidget(QtWidgets.QLabel("Loja:"))
        layout.addWidget(self.loja_input)

        self.marca_input = QtWidgets.QLineEdit()
        self.marca_input.setPlaceholderText("Marca (ex: Samsung)")
        self.marca_input.setStyleSheet("border: 1px solid #cccccc; border-radius: 5px; padding: 5px;")
        layout.addWidget(QtWidgets.QLabel("Marca:"))
        layout.addWidget(self.marca_input)

        self.comboCategoria = QtWidgets.QComboBox()
        self.comboCategoria.addItems(
            ["Todas", "Celulares", "Notebooks", "Periféricos", "Eletrônicos", "Alimentos", "Roupas", "Outros"])
        self.comboCategoria.setStyleSheet("border: 1px solid #cccccc; border-radius: 5px; padding: 5px;")
        layout.addWidget(QtWidgets.QLabel("Categoria:"))
        layout.addWidget(self.comboCategoria)

        self.tendencia_input = QtWidgets.QComboBox()
        self.tendencia_input.addItems(["Todas", "Subindo 🔺", "Caindo 🔻", "Estável ⚪"])
        self.tendencia_input.setStyleSheet("border: 1px solid #cccccc; border-radius: 5px; padding: 5px;")
        layout.addWidget(QtWidgets.QLabel("Tendência:"))
        layout.addWidget(self.tendencia_input)

        button_layout = QtWidgets.QHBoxLayout()
        btn_aplicar = QtWidgets.QPushButton("Aplicar Filtros")
        btn_aplicar.setStyleSheet("""
            QPushButton {
                background-color: #0077b6;
                color: white;
                border-radius: 5px;
                padding: 8px;
            }
            QPushButton:hover {
                background-color: #005f8c;
            }
        """)
        btn_aplicar.clicked.connect(self.aplicar_filtros)

        btn_limpar = QtWidgets.QPushButton("Limpar Filtros")
        btn_limpar.setStyleSheet("""
            QPushButton {
                background-color: #ef476f;
                color: white;
                border-radius: 5px;
                padding: 8px;
            }
            QPushButton:hover {
                background-color: #d43f60;
            }
        """)
        btn_limpar.clicked.connect(self.limpar_filtros)

        button_layout.addWidget(btn_aplicar)
        button_layout.addWidget(btn_limpar)
        layout.addLayout(button_layout)

    def aplicar_filtros(self):
        filtros = {
            'preco_min': self.preco_min.text(),
            'preco_max': self.preco_max.text(),
            'loja': self.loja_input.currentText(),
            'marca': self.marca_input.text(),
            'categoria': self.comboCategoria.currentText(),
            'tendencia': self.tendencia_input.currentText()
        }
        self.accept()
        self.parent().aplicar_filtros_avancados(filtros)

    def limpar_filtros(self):
        self.preco_min.clear()
        self.preco_max.clear()
        self.loja_input.setCurrentIndex(0)  # Volta para "Todas as Lojas"
        self.marca_input.clear()
        self.comboCategoria.setCurrentIndex(0)  # Volta para "Todas"
        self.tendencia_input.setCurrentIndex(0)  # Volta para "Todas"
        # Restaura o DataFrame original e reaplica os filtros limpos
        self.parent().df = self.parent().df_original.copy()
        self.parent().tendencias = self.parent().calcular_tendencias()
        self.parent().atualizar_tabela()
        self.parent().atualizar_dashboard()
        self.accept()


# --- Classe da Nova Tela de Análise de Preços ---
class TelaPrecificacaoInteligente(QtWidgets.QDialog):
    def __init__(self, produto_selecionado, df_completo, parent=None):
        super().__init__(parent)
        self.produto_selecionado = produto_selecionado
        self.df_completo = df_completo
        self.parent = parent

        # Configurações da janela
        self.setWindowTitle("🎯 Análise de Preços")
        self.setMinimumSize(700, 500)
        self.resize(750, 550)

        # Adicionar flags para maximizar/minimizar
        self.setWindowFlags(QtCore.Qt.Window |
                            QtCore.Qt.WindowMinimizeButtonHint |
                            QtCore.Qt.WindowMaximizeButtonHint |
                            QtCore.Qt.WindowCloseButtonHint)

        self.setStyleSheet("""
            QDialog {
                background: qlineargradient(x1:0, y1:0, x2:1, y2:1, 
                    stop:0 #f8f9fa, stop:1 #e9ecef);
                font-family: 'Segoe UI', Arial, sans-serif;
            }
        """)

        # Criar widget principal com scroll
        self.scroll_area = QtWidgets.QScrollArea(self)
        self.scroll_widget = QtWidgets.QWidget()
        self.scroll_area.setWidget(self.scroll_widget)
        self.scroll_area.setWidgetResizable(True)
        self.scroll_area.setVerticalScrollBarPolicy(QtCore.Qt.ScrollBarAsNeeded)
        self.scroll_area.setHorizontalScrollBarPolicy(QtCore.Qt.ScrollBarAsNeeded)

        # Layout principal agora vai no scroll_widget
        self.layout_principal = QtWidgets.QVBoxLayout(self.scroll_widget)
        self.layout_principal.setContentsMargins(20, 20, 20, 20)
        self.layout_principal.setSpacing(15)

        # Layout da janela principal
        main_layout = QtWidgets.QVBoxLayout(self)
        main_layout.setContentsMargins(0, 0, 0, 0)
        main_layout.addWidget(self.scroll_area)

        self.criar_cabecalho_moderno()
        self.criar_secao_produto()
        self.criar_dashboard_precos()
        self.criar_sugestoes_inteligentes()
        self.criar_botoes_acao()

        # Calcular dados automaticamente
        self.calcular_analise_mercado()

    def criar_cabecalho_moderno(self):
        """Cria um cabeçalho moderno com gradiente e ícones"""
        cabecalho = QtWidgets.QWidget()
        cabecalho.setFixedHeight(80)
        cabecalho.setStyleSheet("""
            QWidget {
                background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                    stop:0 #2c3e50, stop:1 #34495e);
                border-radius: 12px;
                margin-bottom: 10px;
            }
        """)

        layout_cabecalho = QtWidgets.QHBoxLayout(cabecalho)
        layout_cabecalho.setContentsMargins(25, 15, 25, 15)

        # Ícone e título
        icone_label = QtWidgets.QLabel("🎯")
        icone_label.setStyleSheet("font-size: 32px; color: white;")

        titulo_label = QtWidgets.QLabel("Análise de Preços")
        titulo_label.setStyleSheet("""
            color: white;
            font-size: 20px;
            font-weight: bold;
            margin-left: 10px;
        """)

        # Layout do texto
        layout_texto = QtWidgets.QVBoxLayout()
        layout_texto.setSpacing(2)
        layout_texto.addWidget(titulo_label)

        layout_cabecalho.addWidget(icone_label)
        layout_cabecalho.addLayout(layout_texto)
        layout_cabecalho.addStretch()

        # Badge de versão
        badge_versao = QtWidgets.QLabel("v1.0")
        badge_versao.setStyleSheet("""
            background-color: rgba(255, 255, 255, 0.2);
            color: white;
            padding: 5px 12px;
            border-radius: 15px;
            font-size: 12px;
            font-weight: bold;
        """)
        layout_cabecalho.addWidget(badge_versao)

        self.layout_principal.addWidget(cabecalho)

    def criar_secao_produto(self):
        """Cria seção com informações do produto selecionado"""
        secao_produto = QtWidgets.QGroupBox("📦 Produto Selecionado")
        secao_produto.setStyleSheet("""
            QGroupBox {
                font-size: 16px;
                font-weight: bold;
                color: #2c3e50;
                border: 2px solid #bdc3c7;
                border-radius: 10px;
                margin-top: 10px;
                padding-top: 10px;
                background-color: white;
            }
            QGroupBox::title {
                subcontrol-origin: margin;
                left: 15px;
                padding: 0 10px 0 10px;
                background-color: white;
            }
        """)

        layout_produto = QtWidgets.QVBoxLayout(secao_produto)
        layout_produto.setContentsMargins(20, 20, 20, 20)

        # Nome do produto com destaque - LAYOUT CORRIGIDO
        nome_produto = str(self.produto_selecionado.get('produto', 'N/A'))
        label_nome = QtWidgets.QLabel(f"<b>{nome_produto}</b>")
        label_nome.setStyleSheet("""
            font-size: 13px;
            color: #2980b9;
            padding: 12px;
            background-color: #ecf0f1;
            border-radius: 8px;
            border-left: 4px solid #3498db;
        """)
        label_nome.setWordWrap(True)
        label_nome.setMinimumHeight(50)
        label_nome.setMaximumHeight(80)

        # ADICIONADO: Preço atual do produto
        preco_atual = extrair_preco(self.produto_selecionado.get('preço', 0))
        if preco_atual:
            label_preco_atual = QtWidgets.QLabel(f"💰 <b>Preço Atual: R$ {preco_atual:.2f}</b>")
            label_preco_atual.setStyleSheet("""
                font-size: 16px;
                color: #27ae60;
                padding: 10px;
                background-color: #d5f4e6;
                border-radius: 8px;
                border-left: 4px solid #27ae60;
                font-weight: bold;
            """)
            layout_produto.addWidget(label_preco_atual)

        # Descrição do produto - LAYOUT CORRIGIDO
        descricao = str(self.produto_selecionado.get('descrição do site', 'Sem descrição disponível'))
        label_desc = QtWidgets.QLabel(f"📝 {descricao}")
        label_desc.setStyleSheet("""
            font-size: 11px;
            color: #7f8c8d;
            padding: 8px;
            font-style: italic;
        """)
        label_desc.setWordWrap(True)
        label_desc.setMinimumHeight(30)
        label_desc.setMaximumHeight(60)

        layout_produto.addWidget(label_nome)
        layout_produto.addWidget(label_desc)

        self.layout_principal.addWidget(secao_produto)

    def criar_dashboard_precos(self):
        """Cria dashboard visual com métricas de preços"""
        dashboard = QtWidgets.QWidget()
        layout_dashboard = QtWidgets.QHBoxLayout(dashboard)
        layout_dashboard.setSpacing(15)

        # Cards de métricas
        self.card_menor_preco = self.criar_card_metrica("💚", "Menor Preço", "R$ 0,00", "#2c3e50")
        self.card_maior_preco = self.criar_card_metrica("💰", "Maior Preço", "R$ 0,00", "#34495e")
        self.card_preco_medio = self.criar_card_metrica("📊", "Preço Médio", "R$ 0,00", "#3498db")
        self.card_produtos_similares = self.criar_card_metrica("🔍", "Similares", "0", "#7f8c8d")

        layout_dashboard.addWidget(self.card_menor_preco)
        layout_dashboard.addWidget(self.card_maior_preco)
        layout_dashboard.addWidget(self.card_preco_medio)
        layout_dashboard.addWidget(self.card_produtos_similares)

        self.layout_principal.addWidget(dashboard)

    def criar_card_metrica(self, icone, titulo, valor, cor):
        """Cria um card visual para métricas"""
        card = QtWidgets.QWidget()
        card.setFixedHeight(120)
        card.setStyleSheet(f"""
            QWidget {{
                background-color: white;
                border-radius: 12px;
                border: 1px solid #ecf0f1;
            }}
            QWidget:hover {{
                border: 2px solid {cor};
                transform: translateY(-2px);
            }}
        """)

        layout_card = QtWidgets.QVBoxLayout(card)
        layout_card.setContentsMargins(15, 15, 15, 15)
        layout_card.setSpacing(5)

        # Ícone
        label_icone = QtWidgets.QLabel(icone)
        label_icone.setStyleSheet("font-size: 24px;")
        label_icone.setAlignment(QtCore.Qt.AlignCenter)

        # Título
        label_titulo = QtWidgets.QLabel(titulo)
        label_titulo.setStyleSheet(f"""
            font-size: 12px;
            color: #7f8c8d;
            font-weight: bold;
            text-align: center;
        """)
        label_titulo.setAlignment(QtCore.Qt.AlignCenter)

        # Valor
        label_valor = QtWidgets.QLabel(valor)
        label_valor.setStyleSheet(f"""
            font-size: 18px;
            color: {cor};
            font-weight: bold;
            text-align: center;
        """)
        label_valor.setAlignment(QtCore.Qt.AlignCenter)
        label_valor.setObjectName("valor")  # Para atualizar depois

        layout_card.addWidget(label_icone)
        layout_card.addWidget(label_titulo)
        layout_card.addWidget(label_valor)

        return card

    def criar_sugestoes_inteligentes(self):
        """Cria seção de sugestões inteligentes de preços"""
        secao_sugestoes = QtWidgets.QGroupBox("🧠 Sugestões Inteligentes de Preços")
        secao_sugestoes.setStyleSheet("""
            QGroupBox {
                font-size: 16px;
                font-weight: bold;
                color: #2c3e50;
                border: 2px solid #3498db;
                border-radius: 10px;
                margin-top: 10px;
                padding-top: 10px;
                background-color: white;
            }
            QGroupBox::title {
                subcontrol-origin: margin;
                left: 15px;
                padding: 0 10px 0 10px;
                background-color: white;
            }
        """)

        layout_sugestoes = QtWidgets.QVBoxLayout(secao_sugestoes)
        layout_sugestoes.setContentsMargins(20, 20, 20, 20)
        layout_sugestoes.setSpacing(15)

        # Container para as estratégias
        self.container_estrategias = QtWidgets.QWidget()
        layout_estrategias = QtWidgets.QHBoxLayout(self.container_estrategias)
        layout_estrategias.setSpacing(15)

        # Estratégia Competitiva
        self.card_competitivo = self.criar_card_estrategia(
            "⚡", "Estratégia Competitiva",
            "Preço agressivo para conquistar mercado",
            "#34495e", "R$ 0,00"
        )

        # Estratégia Equilibrada
        self.card_equilibrado = self.criar_card_estrategia(
            "⚖️", "Estratégia Equilibrada",
            "Preço balanceado entre margem e competitividade",
            "#3498db", "R$ 0,00"
        )

        # Estratégia Premium
        self.card_premium = self.criar_card_estrategia(
            "💎", "Estratégia Premium",
            "Preço diferenciado para maior margem",
            "#2c3e50", "R$ 0,00"
        )

        layout_estrategias.addWidget(self.card_competitivo)
        layout_estrategias.addWidget(self.card_equilibrado)
        layout_estrategias.addWidget(self.card_premium)

        layout_sugestoes.addWidget(self.container_estrategias)

        # Seção de análise personalizada
        self.criar_secao_analise_personalizada(layout_sugestoes)

        self.layout_principal.addWidget(secao_sugestoes)

    def criar_card_estrategia(self, icone, titulo, descricao, cor, preco):
        """Cria card para estratégia de preços"""
        card = QtWidgets.QWidget()
        card.setFixedHeight(160)
        card.setStyleSheet(f"""
            QWidget {{
                background-color: white;
                border-radius: 12px;
                border: 2px solid {cor};
                padding: 5px;
            }}
            QWidget:hover {{
                background-color: {cor};
                color: white;
            }}
        """)

        layout_card = QtWidgets.QVBoxLayout(card)
        layout_card.setContentsMargins(15, 15, 15, 15)
        layout_card.setSpacing(8)

        # Ícone e título
        header_layout = QtWidgets.QHBoxLayout()
        label_icone = QtWidgets.QLabel(icone)
        label_icone.setStyleSheet("font-size: 20px;")

        label_titulo = QtWidgets.QLabel(titulo)
        label_titulo.setStyleSheet(f"""
            font-size: 14px;
            font-weight: bold;
            color: {cor};
        """)

        header_layout.addWidget(label_icone)
        header_layout.addWidget(label_titulo)
        header_layout.addStretch()

        # Descrição
        label_desc = QtWidgets.QLabel(descricao)
        label_desc.setStyleSheet("""
            font-size: 11px;
            color: #7f8c8d;
            line-height: 1.4;
        """)
        label_desc.setWordWrap(True)

        # Preço sugerido
        label_preco = QtWidgets.QLabel(preco)
        label_preco.setStyleSheet(f"""
            font-size: 20px;
            font-weight: bold;
            color: {cor};
            text-align: center;
            padding: 8px;
            background-color: rgba(52, 152, 219, 0.1);
            border-radius: 6px;
        """)
        label_preco.setAlignment(QtCore.Qt.AlignCenter)
        label_preco.setObjectName("preco_sugerido")

        layout_card.addLayout(header_layout)
        layout_card.addWidget(label_desc)
        layout_card.addStretch()
        layout_card.addWidget(label_preco)

        return card

