        app = QtWidgets.QApplication(sys.argv)

        # 1. Exibir diálogo de login
        login_dialog = LoginDialog()
        if login_dialog.exec_() == QtWidgets.QDialog.Accepted:
            # 2. Se login OK, mostrar janela principal
            window = VisualizadorProdutos()
            window.show()
            sys.exit(app.exec_())
        else:
            # 3. Se login falhar ou for cancelado, sair da aplicação
            sys.exit(0)

    except Exception as e:
        logging.critical(f"Erro fatal durante a inicialização do aplicativo: {e}")
        # Tenta mostrar uma mensagem de erro básica se a GUI falhar antes de iniciar
        try:
            error_app = QtWidgets.QApplication.instance()  # Tenta pegar a instância existente
            if not error_app:
                error_app = QtWidgets.QApplication(sys.argv)
            QtWidgets.QMessageBox.critical(None, "Erro Fatal",
                                           f"Ocorreu um erro crítico e a aplicação não pode iniciar:\n{e}")
        except Exception as inner_e:
            print(f"Erro crítico ao tentar exibir a mensagem de erro: {inner_e}")